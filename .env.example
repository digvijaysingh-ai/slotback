ELEVENLABS_API_KEY=

# Postgres for the app (free managed Postgres, co-located with the Space; see docs/designs).
DATABASE_URL=
# Optional: point tests at a running Postgres instead of the embedded pgserver.
TEST_DATABASE_URL=

# Twilio: demo call to the developer's OWN phone only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The only number the system may ever dial (E.164). Anything else is refused.
DEMO_PHONE_ALLOWLIST=

# Ed25519 private key that signs each day's ledger head (hex). Public key: evidence/trusted_key.txt
LEDGER_SIGNING_KEY=

# Shared secret ElevenLabs sends on every tool call (stored as a workspace secret).
TOOL_SECRET=
# HMAC secret for the post-call webhook.
ELEVENLABS_WEBHOOK_SECRET=
# Access code for the Try page and dashboard actions.
DEMO_ACCESS_CODE=
ELEVENLABS_INBOUND_AGENT_ID=
ELEVENLABS_OUTBOUND_AGENT_ID=
# Live API (Render) used by conversation evals
SLOTBACK_API_URL=
